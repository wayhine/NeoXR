<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <ImageView android:layout_width="match_parent" android:layout_height="86dp"
        android:background="@drawable/bg_thumb" android:padding="20dp"
        android:scaleType="centerInside" android:src="@drawable/ic_library_folder"
        android:contentDescription="@null" />
    <TextView android:id="@+id/folderCardName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:maxLines="2" android:ellipsize="end" android:textSize="11sp"
        android:textColor="@color/on_surface" />
    <TextView android:id="@+id/folderCardInfo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:maxLines="2" android:textSize="9sp" android:textColor="@color/on_surface_variant" />
</LinearLayout>
